# 复制为 project.env 后按租用服务器实际路径修改。
PROJECT_DIR=/workspace/project
OMNI_ROOT=/vllm-workspace/vllm-omni
MODEL_DIR=/data/models/LongCat-Image
OUTPUT_ROOT=/workspace/project/outputs

# 2×64GB 时先测试 Ulysses=2；若只租一张大显存卡则改为 1。
NPU_COUNT=2
TENSOR_PARALLEL_SIZE=1
CFG_PARALLEL_SIZE=1
ULYSSES_DEGREE=2
RING_DEGREE=1

# 冒烟测试不是画质验收，只验证 NPU 能完成一次端到端推理。
SMOKE_WIDTH=768
SMOKE_HEIGHT=768
SMOKE_STEPS=10

# 正式测试参数。
BENCHMARK_STEPS=50
GUIDANCE_SCALE=4.0
SEEDS=42,3407,20260903
ENABLE_VAE_MEMORY_OPTS=1

