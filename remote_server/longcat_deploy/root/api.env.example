# Copy to a private shell profile on the remote server; never commit the real token.
export LONGCAT_API_HOST=127.0.0.1
export LONGCAT_API_PORT=8010
export LONGCAT_API_TOKEN=replace-with-a-long-random-value

# Verified base-model runtime: BF16, TP=2, CFG parallel=1, Ulysses=1.
export LONGCAT_API_ENGINE=omni
export LONGCAT_API_TP=2
export LONGCAT_API_CFG_PARALLEL=1
export LONGCAT_API_ULYSSES=1
export LONGCAT_API_RING=1
export LONGCAT_API_VAE_SLICING=1
export LONGCAT_API_VAE_TILING=1
export LONGCAT_API_DEFAULT_STEPS=50
export LONGCAT_API_DEFAULT_GUIDANCE=4.0

# Enable only after the final adapter has passed its own server smoke test.
# export LONGCAT_API_ENGINE=diffusers-lora
# export LONGCAT_API_ADAPTER_DIR=/home/ma-user/work/longcat_lora/outputs/mvp_1024_r16/adapter-final
# export LONGCAT_API_ADAPTER_SCALE=0.8
# export LONGCAT_API_DEVICE=npu:0
# The final LoRA runtime uses Diffusers/PEFT from the isolated evaluation overlay.
# export LONGCAT_API_EXTRA_PYTHONPATH=/home/ma-user/work/longcat_lora/eval_python:/home/ma-user/work/longcat_lora/src/LongCat-Image
# At 1024x1024 on a 64 GiB 910B3, the validated LoRA profile does not need VAE chunking.
# export LONGCAT_API_VAE_SLICING=0
# export LONGCAT_API_VAE_TILING=0
