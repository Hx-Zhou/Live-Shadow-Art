{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-stage.local/schemas/continuous-signal.schema.json",
  "title": "ContinuousSignal",
  "type": "object",
  "additionalProperties": false,
  "required": ["present", "palm", "direction", "velocity", "pinchStrength"],
  "properties": {
    "present": {
      "type": "boolean"
    },
    "palm": {
      "$ref": "#/$defs/vector2"
    },
    "direction": {
      "$ref": "#/$defs/vector2"
    },
    "velocity": {
      "$ref": "#/$defs/vector2"
    },
    "pinchStrength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "vector2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    }
  }
}
