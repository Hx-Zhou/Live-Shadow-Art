{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-stage.local/schemas/rig.schema.json",
  "title": "PuppetRig",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "canvas", "root", "nodes"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["humanoid", "animal"]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "root": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent", "part", "position", "pivot", "rotation", "limits", "zIndex"],
      "properties": {
        "id": { "type": "string" },
        "parent": { "type": ["string", "null"] },
        "part": { "type": "string" },
        "position": { "$ref": "#/$defs/vector2" },
        "pivot": { "$ref": "#/$defs/vector2" },
        "rotation": { "type": "number" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "zIndex": { "type": "integer" }
      }
    },
    "vector2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    }
  }
}
